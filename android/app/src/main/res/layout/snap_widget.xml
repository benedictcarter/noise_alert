<?xml version="1.0" encoding="utf-8"?>
<!--
  Mark over word, not side by side: at two cells wide the row is only about
  90 dp, and the mark is nearly 3:1, so setting the label beside it would
  leave it a space too narrow to hold the word. The plane mark carries the
  brand, so the label is just RECORD -- "FPW RECORD" at 11sp bold runs close
  enough to the cell width to risk being clipped on a dense launcher grid.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snap_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/snap_widget_background"
    android:contentDescription="@string/snap_widget_description"
    android:padding="5dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_plane"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/snap_widget_label"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
