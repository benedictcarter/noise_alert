<?xml version="1.0" encoding="utf-8"?>
<!--
  Plane over word, not side by side: at two cells wide the label is only about
  90 dp, and "FPW SNAP" set beside a 28 dp icon wraps or ellipsises on the
  narrower launchers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snap_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/snap_widget_background"
    android:contentDescription="@string/snap_widget_description"
    android:padding="6dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_plane"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/snap_widget_label"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
